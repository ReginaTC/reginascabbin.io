# Copy to .env.deploy and fill in your server info
SERVER_HOST=your_server_ip_or_domain
SERVER_USER=ubuntu
SERVER_PORT=22
SSH_KEY_PATH=~/.ssh/id_rsa

# Remote directory where static files will be synced
REMOTE_DIR=/var/www/personal-hut

# Optional: your domain. Leave empty if you only use IP.
DOMAIN=

# Guestbook API deployment options
REMOTE_API_DIR=/opt/personal-hut-guestbook
REMOTE_DB_DIR=/var/www/personal-hut/data
GUESTBOOK_PORT=3001
